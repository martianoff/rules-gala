"""End-to-end check of galop_parser with a real galop release.

Not part of rules_gala's own `bazel test //...` (the root .bazelignore skips
e2e/): it downloads galop from GitHub, so it is run by hand, from this
directory:

    bazel test //...

It uses this checkout of rules_gala and the galop version below, resolved
through the `galop` extension and the checksums in
//galop/private:versions.bzl.
"""

module(name = "rules_gala_galop_e2e")

bazel_dep(name = "rules_gala")
local_path_override(
    module_name = "rules_gala",
    path = "../..",
)

bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "rules_java", version = "9.3.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

# ANTLR's Go runtime, which the antlr flavor and its converter build on.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_antlr4_go_antlr_v4")

# The ANTLR tool, for ANTLR's own parser of Calc.g4, which the antlr flavor's
# code sits next to.
http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_jar(
    name = "antlr4_tool",
    sha256 = "bc13a9c57a8dd7d5196888211e5ede657cb64a3ce968608697e4f668251a8487",
    urls = ["https://www.antlr.org/download/antlr-4.13.1-complete.jar"],
)

galop = use_extension("@rules_gala//galop:extensions.bzl", "galop")
galop.toolchain(version = "0.2.4")
use_repo(galop, "galop_toolchains")

register_toolchains("@galop_toolchains//:all")
