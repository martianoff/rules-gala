"""End-to-end check that GALA rules give the transpiler the types of their Go deps.

The transpiler needs the source of a third-party Go module to infer types
that come from it. gala_library, gala_binary and gala_test must all pass
their deps to the transpile step as go_deps. Without that, GALA 0.100.0 and
newer stop with GALA-E0067 ("cannot infer type argument T of Try").

Not part of rules_gala's own `bazel test //...` (the root .bazelignore skips
e2e/): it downloads gala and a Go module, so it is run by hand, from this
directory:

    bazel test //...

It uses this checkout of rules_gala and the gala version below.
"""

module(name = "rules_gala_go_deps_e2e")

bazel_dep(name = "rules_gala")
local_path_override(
    module_name = "rules_gala",
    path = "../..",
)

bazel_dep(name = "gala", version = "0.100.0")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_uuid")
