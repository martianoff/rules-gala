load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "fake_galop_lib",
    srcs = ["main.go"],
    importpath = "github.com/martianoff/rules-gala/galop/tests/fake_galop",
    visibility = ["//visibility:private"],
